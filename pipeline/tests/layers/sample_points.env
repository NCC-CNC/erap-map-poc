# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Layer `sample_points`: the second synthetic test layer (made-up points, no
# real data), for the layer selector, draw order and overlapping pop-ups.
# See lib/config.sh for every setting and docs/design/02_data_layers_and_popups.md
# for the data contract.
#
# A test layer like `sample` (see sample.env); the fixture ships inside the
# pipeline image.

LAYER_INPUT="${PIPELINE_ROOT}/tests/fixtures/sample_points.geojson"

LAYER_FIELDS=(
  id
  name
  category
  count
)

# Becomes the vector tile feature id (and is then not repeated as a property).
LAYER_FEATURE_ID=id

LAYER_MIN_ZOOM=0
LAYER_MAX_ZOOM=10

# Keep every point at every zoom: a drop rate of 1 disables tippecanoe's
# point thinning below the base zoom. No --drop-densest-as-needed.
LAYER_TIPPECANOE_FLAGS=(
  --drop-rate=1
)

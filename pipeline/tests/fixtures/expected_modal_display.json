{
  "title": "Sample polygons",
  "defaultVisible": true,
  "order": 10,
  "modal": {
    "title": "{name}",
    "subtitle": "Sample feature {$id}",
    "sections": [
      {
        "heading": "Summary",
        "description": "A made-up feature of {area_ha:hectares}.",
        "blocks": [
          {
            "type": "attributes",
            "items": [
              {
                "label": "ID",
                "value": {
                  "featureId": true
                }
              },
              {
                "label": "Area",
                "value": {
                  "attribute": "area_ha"
                },
                "format": "hectares"
              },
              {
                "label": "Score",
                "value": {
                  "attribute": "score"
                },
                "format": {
                  "suffix": "/ 100"
                }
              }
            ]
          }
        ]
      },
      {
        "heading": "Values",
        "blocks": [
          {
            "type": "table",
            "caption": "Values by year",
            "rowHeader": "Year",
            "columns": [
              {
                "label": "Value",
                "format": "count"
              },
              {
                "label": "Score",
                "format": "percent"
              }
            ],
            "rows": [
              {
                "label": "2020",
                "values": [
                  "v2020",
                  "score"
                ]
              },
              {
                "label": "2021",
                "values": [
                  "v2021",
                  null
                ]
              },
              {
                "label": "2022",
                "values": [
                  "v2022",
                  null
                ]
              }
            ]
          },
          {
            "type": "chart",
            "chart": "bar",
            "title": "Values, early and late",
            "valueLabel": "Value",
            "format": "count",
            "categories": [
              "First",
              "Second"
            ],
            "series": [
              {
                "label": "Early",
                "attributes": [
                  "v2020",
                  "v2021"
                ]
              },
              {
                "label": "Late",
                "attributes": [
                  "v2023",
                  "v2024"
                ]
              }
            ]
          },
          {
            "type": "chart",
            "chart": "pie",
            "title": "Share by year",
            "valueLabel": "Value",
            "categories": [
              "2020",
              "2024"
            ],
            "series": [
              {
                "label": "Value",
                "attributes": [
                  "v2020",
                  "v2024"
                ]
              }
            ]
          }
        ]
      },
      {
        "heading": "Notes",
        "blocks": [
          {
            "type": "text",
            "text": "Scored {score} out of 100."
          },
          {
            "type": "list",
            "items": [
              {
                "text": "Has a score of {score}",
                "when": "score"
              },
              {
                "text": "Flagged: {flag_reason}",
                "when": "flag"
              }
            ],
            "empty": "Nothing to list."
          }
        ]
      }
    ]
  },
  "layers": [
    {
      "id": "fill",
      "type": "fill",
      "paint": {
        "fill-color": [
          "case",
          [
            "==",
            [
              "typeof",
              [
                "get",
                "score"
              ]
            ],
            "number"
          ],
          [
            "step",
            [
              "get",
              "score"
            ],
            "#deebf7",
            25,
            "#9ecae1",
            50,
            "#4292c6",
            75,
            "#08519c"
          ],
          "#9e9e9e"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "outline",
      "type": "line",
      "paint": {
        "line-color": "#ffffff",
        "line-width": 0.75
      }
    }
  ],
  "legend": {
    "kind": "ramp",
    "shape": "square",
    "border": "#ffffff",
    "opacity": 0.7,
    "items": [
      {
        "color": "#deebf7",
        "label": "0 to 25"
      },
      {
        "color": "#9ecae1",
        "label": "25 to 50"
      },
      {
        "color": "#4292c6",
        "label": "50 to 75"
      },
      {
        "color": "#08519c",
        "label": "75 to 100"
      },
      {
        "color": "#9e9e9e",
        "label": "No score"
      }
    ]
  },

                    {
                      "label": "Late",
                      "attributes": [
                        "v2023",
                        "v2024"
                      ]
                    }
                  ]
                },
                {
                  "type": "chart",
                  "chart": "pie",
                  "title": "Share by year",
                  "valueLabel": "Value",
                  "categories": [
                    "2020",
                    "2024"
                  ],
                  "series": [
                    {
                      "label": "Value",
                      "attributes": [
                        "v2020",
                        "v2024"
                      ]
                    }
                  ]
                },
                {
                  "type": "chart",
                  "chart": "line",
                  "title": "Value by year",
                  "valueLabel": "Value",
                  "format": "integer",
                  "categories": [
                    "2020",
                    "2021",
                    "2022",
                    "2023",
                    "2024"
                  ],
                  "series": [
                    {
                      "label": "Value",
                      "attributes": [
                        "v2020",
                        "v2021",
                        "v2022",
                        "v2023",
                        "v2024"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "heading": "Notes",
              "blocks": [
                {
                  "type": "text",
                  "text": "Scored {score} out of 100."
                },
                {
                  "type": "list",
                  "items": [
                    {
                      "text": "Has a score of {score}",
                      "when": "score"
                    },
                    {
                      "text": "Flagged: {flag_reason}",
                      "when": "flag"
                    }
                  ],
                  "empty": "Nothing to list."
                }
              ]
            }
          ]
        }
      }
    }

              "opacity": 0.7,
              "items": [
                {
                  "color": "#deebf7",
                  "label": "0 to 25"
                },
                {
                  "color": "#9ecae1",
                  "label": "25 to 50"
                },
                {
                  "color": "#4292c6",
                  "label": "50 to 75"
                },
                {
                  "color": "#08519c",
                  "label": "75 to 100"
                },
                {
                  "color": "#9e9e9e",
                  "label": "No score"
                }
              ]
            }
          },
          {
            "id": "score_gradient",
            "label": "Score (gradient)",
            "paint": {
              "fill": {
                "fill-color": [
                  "case",
                  [
                    "==",
                    [
                      "typeof",
                      [
                        "get",
                        "score"
                      ]
                    ],
                    "number"
                  ],
                  [
                    "interpolate",
                    [
                      "linear"
                    ],
                    [
                      "get",
                      "score"
                    ],
                    0,
                    "#f7fbff",
                    50,
                    "#6baed6",
                    100,
                    "#08306b"
                  ],
                  "#9e9e9e"
                ]
              }
            },
            "legend": {
              "kind": "gradient",
              "shape": "square",
              "border": "#ffffff",
              "opacity": 0.7,
              "items": [
                {
                  "color": "#f7fbff",
                  "label": "0",
                  "position": 0
                },
                {
                  "color": "#6baed6",
                  "label": "50",
                  "position": 0.5
                },
                {
                  "color": "#08306b",
                  "label": "100",
                  "position": 1
                },
                {
                  "color": "#9e9e9e",
                  "label": "No score"
                }
              ]
            }
          },
          {
            "id": "area",
            "label": "Area (ha)",
            "paint": {
              "fill": {
                "fill-color": [
                  "case",
                  [
                    "==",
                    [
                      "typeof",
                      [
                        "get",
                        "area_ha"
                      ]
                    ],
                    "number"
                  ],
                  [
                    "interpolate",
                    [
                      "linear"
                    ],
                    [
                      "get",
                      "area_ha"
                    ],
                    3947.5,
                    "#eff3ff",
                    48514.5,
                    "#08519c"
                  ],
                  "#9e9e9e"
                ]
              }
            }
          }
        ],
        "popup": {
          "title": "{name}",
          "size": "dialog",
          "subtitle": "Sample feature {$id}",
          "sections": [
            {
              "heading": "Summary of the feature",
              "tab": "Summary",
              "description": "A made-up feature of {area_ha:integer} ha.",
              "blocks": [
                {
                  "type": "attributes",
                  "items": [
                    {
                      "label": "ID",
                      "value": {
                        "featureId": true
                      }
                    },
                    {
                      "label": "Area",
                      "value": {
                        "attribute": "area_ha"
                      },
                      "format": {
                        "preset": "integer",
                        "suffix": "ha"
                      }
                    },
                    {
                      "label": "Score",
                      "value": {
                        "attribute": "score"
                      },
                      "format": {
                        "suffix": "/ 100"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "heading": "Values",
              "blocks": [
                {
                  "type": "table",

                    }
                  ],
                  "rows": [
                    {
                      "label": "2020",
                      "values": [
                        "v2020",
                        "score"
                      ]
                    },
                    {
                      "label": "2021",
                      "values": [
                        "v2021",
                        null
                      ]
                    },
                    {
                      "label": "2022",
                      "values": [
                        "v2022",
                        null
                      ]
                    }
                  ]
                },
                {

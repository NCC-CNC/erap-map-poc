# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Example only, not a built layer: the ERAP ecoregions from the November
# 2026 play data (ERAP_2026_ecoregions.gdb via RAW_DIR), with the
# attributes that ecoregions.example.style.json shows in its click modal
# (#57). The committed ecoregion layer comes with #58; to try this one,
# copy both files into pipeline/layers/ as ecoregions.env and
# ecoregions.style.json (or into a map config's layerDirs folder).

LAYER_INPUT=ERAP_2026_ecoregions.gdb
LAYER_SOURCE_LAYER=ERAP_2026_ecoregions
LAYER_FIELDS=(
  OBJECTID:id
  ECOREGION_ID:ecoregion_id
  ECOREGION_NAME_EN:name
  ECOZONE_ID:ecozone_id
  ECOZONE_NAME_EN:ecozone
  landscape_ha
  protected_pcnt
  wtw_percent
  intact_pcnt
  modified_pcnt
  protected_intact_pcnt
  protected_modified_pcnt
  pcnt_landscape_forest_cover
  pcnt_forest_protected
  pcnt_forest_wtw
  pcnt_landscape_grassland_cover
  pcnt_grassland_protected
  pcnt_grassland_wtw
  pcnt_landscape_wetland_cover
  pcnt_wetland_protected
  pcnt_wetland_wtw
  pcnt_landscape_lakes_cover
  pcnt_lakes_protected
  pcnt_lakes_wtw
  rivers_km
  pcnt_rivers_protected
  pcnt_rivers_wtw
  coastline_km
  pcnt_coastline_protected
  pcnt_coastline_wtw
  forestry_pcnt
  agriculture_pcnt
  transport_high_pcnt
  transport_low_pcnt
  energy_pcnt
  builtup_pcnt
)
# Calculated fields and action rules (ADR 0011; design note 02), as
# documented there: the Opportunities pie and the action recommendations.
# LAYER_RULES names pipeline/layers/ecoregions.rules.json, next to the .env
# once copied into pipeline/layers/.
LAYER_CALCULATED=(
  'unprotected_intact_pcnt=round(intact_pcnt - protected_intact_pcnt, 2)'
  'unprotected_modified_pcnt=round(modified_pcnt - protected_modified_pcnt, 2)'
)
LAYER_RULES=ecoregions
LAYER_FEATURE_ID=id
LAYER_MIN_ZOOM=0
LAYER_MAX_ZOOM=10
LAYER_PROFILE=coverage

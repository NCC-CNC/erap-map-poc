# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Layer `forest`: forest cover, a binary 30 m raster over Canada (AAFC land
# use 2020 and NFIS 2022). Display only (ADR 0008). See lib/config.sh for
# every setting and docs/design/02_data_layers_and_popups.md for the data
# contract.
#
# The source is not in the repo or the image: set RAW_DIR (see .env.example)
# to the folder holding it, mounted read-only at /data/raw.

LAYER_TYPE=raster
LAYER_INPUT=Forest_AAFC_LUTS_2020_NFIS_2022_30m.tif

# Byte, 1 = forest, nodata 255 (declared in the file, so no LAYER_NODATA).

# z12 is about 38 m at the equator and 19 to 27 m across Canada, so close to
# the 30 m source; the map overzooms past it.
LAYER_MIN_ZOOM=2
LAYER_MAX_ZOOM=12

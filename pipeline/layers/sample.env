# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Layer `sample`: the synthetic test layer (made-up features, no real data).
# See lib/config.sh for every setting and docs/design/02_data_layers_and_popups.md
# for the data contract.
#
# The fixture ships inside the pipeline image, so this layer builds without
# anything in data/raw and gives the skeleton an end-to-end layer.

LAYER_INPUT="${PIPELINE_ROOT}/tests/fixtures/sample.geojson"

# Attributes to keep: `src` or `src:dest`. `notes` in the fixture is dropped.
LAYER_FIELDS=(
  id
  NAME_EN:name
  area_ha
  score
  v2020
  v2021
  v2022
  v2023
  v2024
)

# Becomes the vector tile feature id (and is then not repeated as a property).
LAYER_FEATURE_ID=id

LAYER_MIN_ZOOM=0
LAYER_MAX_ZOOM=8

# No LAYER_PROFILE: these polygons do not touch, so this is not a coverage
# (see the coverage profile in lib/config.sh).
LAYER_TIPPECANOE_FLAGS=(
  --drop-densest-as-needed
)

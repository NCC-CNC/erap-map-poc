# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Layer `protected_areas`: Canada's protected and conserved areas (CPCAD,
# 2025, as prepared by NCC), dissolved into 112,050 polygons with no
# attributes, from the November 2026 play data. Display only: one green
# fill, no pop-up (#14). See lib/config.sh for every setting and
# docs/design/02_data_layers_and_popups.md for the data contract.
#
# The source is not in the repo or the image: set RAW_DIR (see .env.example)
# to the folder holding it, mounted read-only at /data/raw.

LAYER_INPUT=protected_areas.gdb
LAYER_SOURCE_LAYER=cpcad_ncc_dslv_2025

# No attributes. OBJECTID, the file geodatabase's row id, is kept only as
# the feature id the drop guard reads.
LAYER_FIELDS=(
  OBJECTID:id
)
LAYER_FEATURE_ID=id

# Dissolved, so no overlaps, but not a contiguous coverage: no profile and
# no drop flags, so tippecanoe drops only what its tiny polygon reduction
# and its simplification collapse.
LAYER_MIN_ZOOM=0
LAYER_MAX_ZOOM=12
# Drop guard: an area must be in a zoom's tiles once its largest part
# covers 4 screen pixels (at 256 px tiles; 4 x 4 CSS pixels on the map).
# The default of 1 fails at z12 on slivers, such as OBJECTID 66341 (399 m2
# but under a metre wide), which simplification collapses; nothing that
# can be seen goes.
LAYER_MIN_VISIBLE_PX=4

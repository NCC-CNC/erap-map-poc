# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Layer `ecoregions`: the ERAP ecoregions (149 polygons over Canada, a
# contiguous coverage) with their ERAP metrics, from the November 2026 play
# data. Drawn on top of the other layers; a click opens the modal in
# ecoregions.style.json. See lib/config.sh for every setting and
# docs/design/02_data_layers_and_popups.md for the data contract and the
# decisions behind the colours and the modal (#14).
#
# The source is not in the repo or the image: set RAW_DIR (see .env.example)
# to the folder holding it, mounted read-only at /data/raw.

LAYER_INPUT=ERAP_2026_ecoregions.gdb
LAYER_SOURCE_LAYER=ERAP_2026_ecoregions

# Only the attributes the colour themes and the modal use (English only;
# the French names are not tiled). OBJECTID is the feature id: tippecanoe
# needs an integer and ECOREGION_ID is text, so that is kept as an
# attribute. OBJECTID is the file geodatabase's row id and may change when
# the data is exported again (a stable id is an open question, #13).
LAYER_FIELDS=(
  OBJECTID:id
  ECOREGION_ID:ecoregion_id
  ECOREGION_NAME_EN:name
  ECOZONE_ID:ecozone_id
  ECOZONE_NAME_EN:ecozone
  landscape_ha
  protected_pcnt
  wtw_percent
  wtw_area_ha
  intact_pcnt
  modified_pcnt
  protected_intact_pcnt
  protected_modified_pcnt
  pcnt_landscape_forest_cover
  pcnt_forest_protected
  pcnt_forest_wtw
  pcnt_landscape_grassland_cover
  pcnt_grassland_protected
  pcnt_grassland_wtw
  pcnt_landscape_wetland_cover
  pcnt_wetland_protected
  pcnt_wetland_wtw
  pcnt_landscape_lakes_cover
  pcnt_lakes_protected
  pcnt_lakes_wtw
  rivers_km
  pcnt_rivers_protected
  pcnt_rivers_wtw
  coastline_km
  pcnt_coastline_protected
  pcnt_coastline_wtw
  forestry_pcnt
  agriculture_pcnt
  transport_high_pcnt
  transport_low_pcnt
  energy_pcnt
  builtup_pcnt
)
LAYER_FEATURE_ID=id

# Calculated fields and action rules (ADR 0011; design note 02): the
# Opportunities pie (intact and modified land outside protected areas, as %
# of the ecoregion) and the action recommendations from ecoregions.rules.json.
LAYER_CALCULATED=(
  'unprotected_intact_pcnt=round(intact_pcnt - protected_intact_pcnt, 2)'
  'unprotected_modified_pcnt=round(modified_pcnt - protected_modified_pcnt, 2)'
)
LAYER_RULES=ecoregions

LAYER_MIN_ZOOM=0
LAYER_MAX_ZOOM=10
LAYER_PROFILE=coverage
# About 90,000 polygon parts, mostly small islands: up to z7 keep only parts
# of 4 px or more (each ecoregion keeps its largest) and simplify borders as
# a coverage; z8 to z10 are full detail (design note 02, Low-zoom
# generalisation).
LAYER_GENERALISE_MAX_ZOOM=7

# shellcheck shell=bash disable=SC2034 # variables are read by lib/config.sh.
#
# Layer `agriculture`: agricultural land, a binary 30 m raster over Canada
# (2022). Display only (ADR 0008). See lib/config.sh for every setting and
# docs/design/02_data_layers_and_popups.md for the data contract.
#
# The source is not in the repo or the image: set RAW_DIR (see .env.example)
# to the folder holding it, mounted read-only at /data/raw.

LAYER_TYPE=raster
LAYER_INPUT=HM_CA_ag2022_r90_merged_prj_30_binary.tif

# Float32, 0 or 1 = agriculture, nodata NaN (declared in the file, so no
# LAYER_NODATA); 0 and nodata are both left transparent.

LAYER_MIN_ZOOM=2
LAYER_MAX_ZOOM=12

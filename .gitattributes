# Use LF line endings for all text files, on every OS. Shell scripts,
# Dockerfiles and configs here run inside Linux containers, and a CRLF
# checkout on Windows (core.autocrlf=true) breaks them with errors like
# "set: pipefail\r: invalid option name".
* text=auto eol=lf

# Binary formats, never converted.
*.png binary
*.jpg binary
*.pmtiles binary
*.mbtiles binary
*.gpkg binary
*.fgb binary
*.zip binary

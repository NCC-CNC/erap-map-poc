{
  "$schema": "./pipeline/schema/map-config.schema.json",
  "map": { "center": [-96, 60], "zoom": 3, "basemap": "light" },
  "overrides": {
    "forest": { "env": { "LAYER_MAX_ZOOM": 10, "LAYER_GREY_LEVELS": 8 } },
    "agriculture": { "env": { "LAYER_MAX_ZOOM": 10, "LAYER_GREY_LEVELS": 8 } },
    "ecoregions": {
      "env": { "LAYER_MAX_ZOOM": 10, "LAYER_GENERALISE_MAX_ZOOM": 9 }
    },
    "protected_areas": {
      "input": "ProtectedConservedArea_2025.gdb",
      "env": {
        "LAYER_SOURCE_LAYER": "ProtectedConservedArea_2025",
        "LAYER_MAX_ZOOM": 10
      }
    }
  },
  "requiredInputs": {
    "protected_areas": "ProtectedConservedArea_2025.gdb"
  }
}

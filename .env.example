# Copy to .env and fill in. .env is git-ignored. docker compose reads it from
# the repo root. Every value is optional.

# Host ports for the web map (`web`) and the Vite dev server (`web-dev`).
# WEB_PORT=8080
# WEB_DEV_PORT=5173

# Linux only: run the pipeline as your own user so the files it writes to
# data/tiles/ are yours. Use the output of `id -u` and `id -g`. Not needed on
# Docker Desktop (Windows, macOS).
# PIPELINE_UID=10001
# PIPELINE_GID=10001

# web-dev: poll for file changes (1) or rely on file events (0). Polling is
# the default because events do not reach the container from Windows bind
# mounts; on Linux you can set 0.
# VITE_USE_POLLING=1

# Pipeline source data: the folder mounted read-only at /data/raw, which
# layer configs (pipeline/layers/*.env) name their inputs in. Defaults to
# ./data/raw. Point it at data kept outside the repo, for example a shared
# drive; on Windows (Git Bash or PowerShell) a path like
# C:/data/ERAP_play_data works.
# RAW_DIR=./data/raw

# Your local map config (ADR 0009): which layers to build and show, your
# own overrides and local-only layers, and the map's opening view. A path
# relative to the repo root; the default is map.config.json (git-ignored;
# copy map.config.example.json to start). No file means every committed
# layer, as it is.
# MAP_CONFIG=map.config.json

# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# docker compose reads it from the repo root, and `npm run dev` reads
# CARTO_API_KEY from it too. Every value is optional.

# CARTO API key for the Positron and Dark Matter basemaps (ADR 0005). Empty
# means the keyless OpenFreeMap basemap. docker compose strips the CR of a
# Windows (CRLF) line ending here, but a key exported in the shell with a
# stray CR makes the web container refuse to start.
CARTO_API_KEY=

# Host ports for the web map (`web`) and the Vite dev server (`web-dev`).
# WEB_PORT=8080
# WEB_DEV_PORT=5173

# Linux only: run the pipeline as your own user so the files it writes to
# data/tiles/ are yours. Use the output of `id -u` and `id -g`. Not needed on
# Docker Desktop (Windows, macOS).
# PIPELINE_UID=10001
# PIPELINE_GID=10001

# web-dev: poll for file changes (1) or rely on file events (0). Polling is
# the default because events do not reach the container from Windows bind
# mounts; on Linux you can set 0.
# VITE_USE_POLLING=1

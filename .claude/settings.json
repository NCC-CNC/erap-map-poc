{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git merge*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git rm --cached *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git check-ignore *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(docker compose run --rm --build pipeline)",
      "Bash(docker compose run --rm --build pipeline *)",
      "Bash(docker compose run --rm pipeline)",
      "Bash(docker compose run --rm pipeline *)",
      "Bash(docker compose run --rm --build --entrypoint inspect.sh pipeline *)",
      "Bash(docker compose run --rm --entrypoint inspect.sh pipeline *)",
      "Bash(scripts/screenshot.sh *)",
      "Bash(docker compose up -d --build web)",
      "Bash(docker compose up -d web)",
      "Bash(docker compose --profile dev up -d web-dev)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(curl -fsS http://localhost:*)",
      "Bash(export MSYS_NO_PATHCONV=1)",
      "Bash(docker run --rm -v * -w /mnt koalaman/shellcheck:v0.11.0 *)",
      "Bash(docker run --rm -v * -w /mnt hadolint/hadolint:v2.15.1 hadolint *)",
      "Bash(docker build --target test -t erap-map-pipeline:test pipeline)",
      "Bash(docker run --rm erap-map-pipeline:test)",
      "Bash(docker compose build pipeline)",
      "Bash(docker compose build web)",
      "Bash(docker compose --profile dev run --rm --no-deps web-dev sh -c 'npm ci && npm run lint && npm run typecheck && npm test && npm run build*)",
      "Bash(docker compose config -q)",
      "Bash(docker compose --profile pipeline --profile dev config -q)",
      "Bash(docker run --rm -v * -w /repo rhysd/actionlint:1.7.7 -color)",
      "Bash(docker run --rm -v * -w /repo node:26.13.0-bookworm-slim npx --yes markdownlint-cli *)",
      "Bash(git grep *)",
      "Bash(gh api *)",
      "Bash(cat MEMORY.md)"
    ],
    "ask": [
      "Bash(docker compose run *--remove*)",
      "Bash(docker run *--remove*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}

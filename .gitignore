# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Build output (adjust for your stack: dist/, build/, out/, target/, __pycache__/, etc.)
node_modules/
dist/
coverage/
*.tsbuildinfo
__pycache__/
playwright-report/
test-results/

# Logs and temp
*.log
tmp/
.tmp/

# Environment / secrets
.env
.env.*
!.env.example

# Claude Code local overrides (personal, not shared)
.claude/settings.local.json
.claude/worktrees/

# Pipeline data (input and generated tiles are not committed; small sample
# fixtures live under pipeline/tests/fixtures/ instead)
data/raw/*
data/tiles/*
!data/raw/.gitkeep
!data/tiles/.gitkeep
*.pmtiles
*.mbtiles

# Raster and other source formats, and the pipeline's working directory
# (prepared rasters, colour VRTs, tile directories). Real data never goes in
# git; CI makes its synthetic GeoTIFF at test time.
*.tif
*.tiff
*.vrt
*.gdb/
data/work/*
!data/work/.gitkeep

# Local map config and local-only layer configs (ADR 0009): yours, not
# shared. map.config.example.json is the committed starting point.
/map.config*.json
!/map.config.example.json
pipeline/layers.local/
